<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Local Temperature</name>
  <width>1180</width>
  <height>720</height>
  <background_color><color red="236" green="240" blue="244"/></background_color>
  <macros>
    <CP>L4-NSOPCPA-NL1</CP>
  </macros>

  <!-- Header and navigation -->
  <widget type="rectangle" version="2.0.0">
    <name>Header background</name>
    <x>0</x><y>0</y><width>1180</width><height>72</height>
    <line_color><color red="25" green="43" blue="62"/></line_color>
    <background_color><color red="25" green="43" blue="62"/></background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Title</name><text>L4 Laser / Regenerator Overview</text>
    <x>24</x><y>13</y><width>520</width><height>42</height>
    <font><font family="Liberation Sans" style="BOLD" size="25.0"/></font>
    <foreground_color><color red="255" green="255" blue="255"/></foreground_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Mock badge</name><text>LOCAL MOCK IOC - NOT FOR OPERATIONS</text>
    <x>24</x><y>50</y><width>450</width><height>18</height>
    <font><font family="Liberation Sans" style="BOLD" size="11.0"/></font>
    <foreground_color><color red="255" green="193" blue="7"/></foreground_color>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Overview navigation</name><text>OVERVIEW</text>
    <actions><action type="open_display"><file>temperature.bob</file><target>replace</target><description>Open overview</description></action></actions>
