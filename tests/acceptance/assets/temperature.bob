    <background_color><color red="45" green="101" blue="151"/></background_color>
    <foreground_color><color red="255" green="255" blue="255"/></foreground_color>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Cooling navigation</name><text>COOLING</text>
    <actions><action type="open_display"><file>flow.bob</file><target>replace</target><description>Open cooling overview</description></action></actions>
