  <widget type="xyplot" version="3.0.0">
    <name>X/Y Plot</name>
    <x>140</x>
    <y>100</y>
    <width>500</width>
    <height>500</height>
    <x_axis>
      <title>X</title>
      <autoscale>false</autoscale>
