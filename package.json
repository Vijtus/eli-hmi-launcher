{
  "name": "eli-hmi-launcher",
  "private": true,
  "version": "0.4.0",
  "description": "Minimal L4 control systems GUI launcher built with Electron and a YAML configuration table.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "validate-config": "tsx scripts/validate-config.ts",
    "intake-to-yaml": "tsx scripts/intake-to-yaml.ts",
    "smoke:hmi-lifecycle": "tsx scripts/smoke-hmi-lifecycle.ts",
    "smoke:labview-contract": "tsx scripts/smoke-labview-contract.ts",
    "smoke:phoebus-local": "tools/phoebus-local/self-test.sh",
    "acceptance:local": "tools/run-local-acceptance.sh",
    "check": "tsc -b && electron-vite build",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm test && npm run check && npm run validate-config && npm run validate-config -- config/launcher.example-real.yaml && npm run validate-config -- config/phoebus-local.yaml && npm run validate-config -- config/local-acceptance.yaml && npm run smoke:phoebus-local"
  },
  "dependencies": {
    "@picocss/pico": "2.1.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "electron": "40.10.0",
    "electron-vite": "5.0.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
