{
  "name": "eli-hmi-launcher",
  "private": true,
  "version": "0.4.0",
  "description": "Config-driven Electron launcher for control-system HMIs.",
  "author": "ELI ERIC <controls@eli-beams.eu>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/eli-eric/eli-hmi-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/eli-eric/eli-hmi-launcher.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "validate-config": "tsx scripts/validate-config.ts",
    "dump-config": "tsx scripts/dump-config.ts",
    "demo:git-config": "tsx tools/demo-git-config.mts",
    "smoke:labview-contract": "tsx scripts/smoke-labview-contract.ts",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "smoke:phoebus-local": "tests/acceptance/phoebus/self-test.sh",
    "acceptance:local": "tests/acceptance/run.sh",
    "check": "tsc -b && electron-vite build",
    "pack": "npm run check && electron-builder --dir",
    "dist": "npm run check && electron-builder",
    "dist:linux": "npm run check && electron-builder --linux",
    "dist:win": "npm run check && electron-builder --win",
    "dist:mac": "npm run check && electron-builder --mac",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm test && npm run check && npm run validate-config && npm run validate-config -- examples/launcher.full.yaml",
    "verify:linux": "npm run verify && npm run smoke:phoebus-local",
    "catalog-import": "tsx tools/catalog-import/intake-to-yaml.ts"
  },
  "dependencies": {
    "isomorphic-git": "^1.41.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "electron": "40.10.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
