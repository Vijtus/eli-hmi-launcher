{
    "compilerOptions": {
        "composite": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "electron.vite.config.ts",
        "src/main/**/*.ts",
        "src/preload/**/*.ts",
        "src/shared/**/*.ts"
    ]
}